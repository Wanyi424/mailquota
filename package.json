{
  "name": "mailquota",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:backend": "node --env-file-if-exists=.env --watch src/server.js",
    "dev:frontend": "vite build --watch --config frontend/vite.config.ts",
    "start": "node --env-file-if-exists=.env src/server.js",
    "init": "node --env-file-if-exists=.env scripts/init.js",
    "password": "node scripts/password.js",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "check:frontend": "tsc --noEmit -p frontend/tsconfig.json",
    "test": "npm run build:frontend && npm run check:frontend && node --import tsx --test --test-concurrency=1 test/*.test.js",
    "test:frontend": "npm run build:frontend && npm run check:frontend && node --import tsx --test --test-concurrency=1 test/frontend.test.js test/admin.test.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "ipaddr.js": "2.5.0",
    "nodemailer": "10.0.9",
    "pg": "^8.16.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "selfsigned": "5.5.0",
    "smtp-server": "3.19.12",
    "supertest": "7.2.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
