{
  "name": "mailquota",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "init": "node --env-file-if-exists=.env scripts/init.js",
    "password": "node scripts/password.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:frontend": "node --test --test-concurrency=1 test/frontend.test.js test/admin.test.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.0.3",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "ipaddr.js": "2.5.0",
    "nodemailer": "10.0.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "selfsigned": "5.5.0",
    "smtp-server": "3.19.12",
    "supertest": "7.2.2"
  }
}
