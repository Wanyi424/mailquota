# ==========================================
# 1. 基础服务与持久化配置
# ==========================================
# 运行时文件目录
STORAGE_DIR=./storage
# PostgreSQL 连接地址。可填写宿主机、远程服务器或 Docker 内服务地址。
# 使用 docker-compose.postgres.yml 时，该值会由 Compose 覆盖为 postgres 服务地址。
DATABASE_URL=postgres://mailquota:change-me@127.0.0.1:5432/mailquota

# 仅使用 Docker 内置 PostgreSQL 时需要设置；连接宿主机 PostgreSQL 不需要此变量。
POSTGRES_PASSWORD=change-me

# 本地监听地址（开发或 Nginx 代理保持 127.0.0.1，Docker 环境用 0.0.0.0）
HOST=127.0.0.1

# 服务监听端口
PORT=3000

# 反向代理信任范围（保持 loopback 即可信任本机 Nginx）
TRUST_PROXY=loopback

# 服务对外的实际访问根地址（支持 http:// 和 https://，结尾不带斜杠 /）
# 本地示例：http://localhost:3000；协议、主机和端口须与浏览器实际访问一致
PUBLIC_ORIGIN=https://mail.example.com

# ==========================================
# 2. 管理员与会话安全配置
# ==========================================
# 管理员登录账号名
ADMIN_USERNAME=admin

# 执行 pnpm run password 自动将以下配置写入 .env，无需复制粘贴：
# - ADMIN_PASSWORD_HASH：管理员密码的 bcrypt 盐哈希（不保存明文密码）
# - SESSION_SECRET：仅在缺失或无效时自动生成，已有有效值保留
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# ==========================================
# 3. 邮件发送（SMTP）配置
# ==========================================
# SMTP 发信服务器域名（如 smtpdm.aliyun.com / smtp.exmail.qq.com 等）
SMTP_HOST=smtpdm.aliyun.com

# SMTP 端口（SSL 通常为 465；STARTTLS 通常为 587）
SMTP_PORT=465

# 是否开启 SSL 协议（465 端口填 true，587 端口填 false）
SMTP_SECURE=true

# SMTP 登录用户名/发信账号
SMTP_USER=service@example.com

# SMTP 专用授权码或密码
SMTP_PASSWORD=your_smtp_password

# 邮件发送者真实邮箱地址（必须是合法的邮件地址）
SMTP_FROM=service@example.com