# ==========================================
# 1. 基础服务与持久化配置
# ==========================================
# 数据文件存储目录（存放 SQLite 数据库、客户配置 json 和邮件模板）
STORAGE_DIR=./storage

# 本地监听地址（开发或 Nginx 代理保持 127.0.0.1，Docker 环境用 0.0.0.0）
HOST=127.0.0.1

# 服务监听端口
PORT=3000

# 反向代理信任范围（保持 loopback 即可信任本机 Nginx）
TRUST_PROXY=loopback

# 服务对外的实际访问根地址（必须以 https:// 开头，且结尾绝对不能带斜杠 /）
PUBLIC_ORIGIN=https://mail.example.com

# ==========================================
# 2. 管理员与会话安全配置
# ==========================================
# 管理员登录账号名
ADMIN_USERNAME=admin

# 以下两项请在终端执行 npm run password 生成后复制填入：
# - ADMIN_PASSWORD_HASH：管理员密码的 bcrypt 哈希（建议保留单引号）
# - SESSION_SECRET：管理端会话安全加密密钥
ADMIN_PASSWORD_HASH='$2a$12$...'
SESSION_SECRET=...

# ==========================================
# 3. 邮件发送（SMTP）配置
# ==========================================
# SMTP 发信服务器域名（如 smtpdm.aliyun.com / smtp.exmail.qq.com 等）
SMTP_HOST=smtpdm.aliyun.com

# SMTP 端口（SSL 通常为 465；STARTTLS 通常为 587）
SMTP_PORT=465

# 是否开启 SSL 协议（465 端口填 true，587 端口填 false）
SMTP_SECURE=true

# SMTP 登录用户名/发信账号
SMTP_USER=service@example.com

# SMTP 专用授权码或密码
SMTP_PASSWORD=your_smtp_password

# 邮件发送者真实邮箱地址（必须是合法的邮件地址）
SMTP_FROM=service@example.com
